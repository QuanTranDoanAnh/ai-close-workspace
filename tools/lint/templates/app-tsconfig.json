{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "./webapp",
    "types": ["@sapui5/types"],
    "paths": {
      "com/example/closeworkspace/APP_NAME/*": ["./webapp/*"]
    }
  },
  "include": ["./webapp/**/*"]
}
